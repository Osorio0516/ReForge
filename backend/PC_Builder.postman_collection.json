          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Edit component",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/components/{{id}}",
        "description": "Edit component",
        "body": {
          "mode": "raw",
          "raw": "{\"price\":8500}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Delete unused component",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/components/{{id}}",
        "description": "Delete unused component"
      }
    },
    {
      "name": "List rule records",
      "request": {
        "method": "GET",
        "header": [],
