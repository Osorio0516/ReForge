    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5000/api"
    },
    {
      "key": "id",
      "value": ""
    },
    {
      "key": "buildId",
      "value": ""
    },
    {
      "key": "componentId",
      "value": ""
    },
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "itemId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "List category records",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/categories",
        "description": "List category records"
      }
    },
    {
      "name": "Get one category",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/categories/{{id}}",
        "description": "Get one category"
      }
    },
    {
      "name": "Create category",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/categories",
        "description": "Create category",
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"CPU\",\"slug\":\"cpu\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Edit category",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/categories/{{id}}",
        "description": "Edit category",
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Processors\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Delete unused category",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/categories/{{id}}",
        "description": "Delete unused category"
      }
    },
    {
      "name": "List component records",
      "request": {
        "method": "GET",
        "header": [],
