      "name": "Edit rule",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/compatibility-rules/{{id}}",
        "description": "Edit rule",
        "body": {
          "mode": "raw",
          "raw": "{\"enabled\":false}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Delete unused rule",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/compatibility-rules/{{id}}",
        "description": "Delete unused rule"
      }
    },
    {
      "name": "Database health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health",
        "description": "Database health"
      }
    },
    {
      "name": "List/search builds",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/builds",
        "description": "List/search builds"
      }
    },
    {
      "name": "Create draft",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/builds",
        "description": "Create draft",
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Gaming PC\",\"budget\":50000}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Get populated build",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/builds/{{id}}",
        "description": "Get populated build"
      }
    },
    {
      "name": "Edit and reset to draft",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/builds/{{id}}",
        "description": "Edit and reset to draft",
        "body": {
          "mode": "raw",
          "raw": "{\"budget\":55000}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Delete build and all its items",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/builds/{{id}}",
        "description": "Delete build and all its items"
      }
    },
    {
      "name": "List selected parts",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/builds/{{id}}/items",
        "description": "List selected parts"
      }
    },
    {
      "name": "Select component",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/builds/{{id}}/items",
        "description": "Select component",
        "body": {
          "mode": "raw",
          "raw": "{\"componentId\":\"{{componentId}}\",\"quantity\":1}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Change selected quantity",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/build-items/{{id}}",
        "description": "Change selected quantity",
        "body": {
          "mode": "raw",
          "raw": "{\"quantity\":2}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Remove selected part",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/build-items/{{id}}",
        "description": "Remove selected part"
      }
    },
    {
      "name": "Copy build and selections",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/builds/{{id}}/copies",
        "description": "Copy build and selections",
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Second build\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Rule-based completion",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/builds/{{id}}/status",
        "description": "Rule-based completion",
        "body": {
          "mode": "raw",
          "raw": "{\"status\":\"completed\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Compute itemized current total",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/builds/{{id}}/pricing",
        "description": "Compute itemized current total"
      }
    },
    {
      "name": "Compute budget difference",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/builds/{{id}}/budget",
        "description": "Compute budget difference"
      }
    },
    {
      "name": "Evaluate specifications",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/builds/{{id}}/compatibility",
        "description": "Evaluate specifications"
      }
    },
    {
      "name": "Estimate PSU requirement",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/builds/{{id}}/power",
        "description": "Estimate PSU requirement"
      }
    },
    {
      "name": "Compare two builds",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/builds/comparison?left={{id}}&right={{id}}",
        "description": "Compare two builds"
      }
    },
    {
      "name": "Aggregate saved build statistics",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/builds/statistics",
